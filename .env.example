# ============================================
# NovelAI Platform 环境变量配置
# ============================================

# --------------------------------------------
# 数据库配置 (必需)
# --------------------------------------------
# PostgreSQL 数据库密码
# 建议使用强密码（至少 16 字符，包含大小写字母、数字和特殊字符）
POSTGRES_PASSWORD=your_secure_password

# --------------------------------------------
# JWT 认证配置 (必需)
# --------------------------------------------
# JWT 密钥，用于签名和验证访问令牌
# 生成强密钥命令: openssl rand -base64 32
# 最小长度: 32 字符（推荐 44+ 字符）
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# --------------------------------------------
# AI Provider API Keys (至少配置一个)
# --------------------------------------------
# OpenAI API Key (推荐用于生产环境)
OPENAI_API_KEY=sk-xxx

# Anthropic Claude API Key
ANTHROPIC_API_KEY=sk-ant-xxx

# Google Gemini API Key
GEMINI_API_KEY=xxx

# --------------------------------------------
# AI Provider 默认配置
# --------------------------------------------
# 默认使用的 AI 提供商: openai, anthropic, gemini
DEFAULT_PROVIDER=openai

# 默认使用的模型
# OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Anthropic: claude-3-opus, claude-3-sonnet, claude-3-haiku
# Gemini: gemini-pro, gemini-pro-vision
DEFAULT_MODEL=gpt-4o

# --------------------------------------------
# OAuth 配置 (可选)
# --------------------------------------------
# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinuxDo OAuth
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=

# --------------------------------------------
# 邮件配置 (可选，用于密码重置)
# --------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# --------------------------------------------
# 前端配置 (可选)
# --------------------------------------------
# 前端 API 基础 URL，用于 Nginx 反向代理
# Docker 环境默认值: http://gateway:8080
# 本地开发环境: http://localhost:8080
# VITE_API_BASE_URL=http://gateway:8080
